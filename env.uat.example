# Copy to .env.uat ON THE VPS (in the backend UAT folder) and fill in. Never commit .env.uat.
# Easiest: copy prod's env file, then change ONLY the 5 lines marked (CHANGE).

# (CHANGE) prod uses 8080. Host network means both APIs share the machine's ports.
PORT=8081

# (CHANGE) same user/password/host (localhost) as prod, database name is erp_db_uat
DATABASE_URL=postgres://postgres:<PASSWORD>@localhost:5432/erp_db_uat?sslmode=disable

# (CHANGE) must differ from prod. Generate with: openssl rand -hex 32
JWT_SECRET=7Cl7hj7OEnxQlXOw

JWT_EXPIRY_HOURS=8
JWT_REFRESH_HOURS=168
CORS_ORIGINS=*
BCRYPT_COST=12

# (CHANGE)
APP_ENV=staging

# (CHANGE) attachment links in API responses are built from this
PUBLIC_BASE_URL=https://portal.geniuslp.com/erp/uat
