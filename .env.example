# ERP API — Environment variables
# Copy this file to .env and fill in your values

PORT=8080
DATABASE_URL=postgres://postgres:root@localhost:5432/postgres?sslmode=disable

# JWT — MUST change in production, at least 32 characters
JWT_SECRET=change-me-in-production-use-32chars!!
JWT_EXPIRY_HOURS=8
JWT_REFRESH_HOURS=168

CORS_ORIGINS=*
APP_ENV=development
BCRYPT_COST=12

# Public origin this API is reachable at (scheme+host[:port], no trailing slash).
# Used to turn stored relative file paths (e.g. uploads/pr/2026/08/x.pdf) into absolute
# URLs in attachment/image API responses, so links work when opened directly.
PUBLIC_BASE_URL=http://localhost:8080
